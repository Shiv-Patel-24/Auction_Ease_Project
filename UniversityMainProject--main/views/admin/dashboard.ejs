<%- include('../includes/navbar') %>
<link rel="stylesheet" href="/css/dashboard.css">

<div class="container" style="padding-top: 0.25rem;">

  <!-- Header area -->
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;gap:1rem;">
    <div>
      <h1 class="dashboard-title" style="margin:0;">Admin Control Panel</h1>
      <p class="muted" style="margin:6px 0 0 0;">Live user management · monitor listings & reviews</p>
    </div>

    <div style="display:flex;gap:0.75rem;align-items:center;">
      <input id="adminSearch" placeholder="Search users or listings..." aria-label="Search" 
             style="min-width:260px;padding:10px 12px;border-radius:999px;border:none;background:rgba(255,255,255,0.03);color:inherit;box-shadow:0 6px 18px rgba(6,10,20,0.3);" />

      <div style="display:flex;gap:8px;align-items:center;">
        <span class="badge badge-admin" style="padding:6px 10px;">Admin</span>
        <span class="badge badge-user" style="padding:6px 10px;">User</span>
      </div>
    </div>
  </div>

  <% if (success && success.length) { %>
    <div class="flash flash-success"><%= success %></div>
  <% } %>
  <% if (error && error.length) { %>
    <div class="flash flash-error"><%= error %></div>
  <% } %>

  <div class="dashboard-row" style="align-items:flex-start;">

    <!-- USERS CARD -->
    <div class="table-card" aria-labelledby="usersHeading">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">
        <h3 class="table-title" id="usersHeading" style="margin:0;">Users</h3>
        <small class="muted">Page <%= (userPagination && userPagination.page) ? userPagination.page : 1 %></small>
      </div>

      <div style="overflow:auto;">
        <table class="custom-table" id="usersTable">
          <thead>
            <tr>
              <th style="width:56px">#</th>
              <th>Username / Email</th>
              <th style="width:110px">Role</th>
              <th style="width:160px">Joined</th>
              <th style="width:220px">Actions</th>
            </tr>
          </thead>
          <tbody id="usersTbody">
            <% users.forEach((user, idx) => {
                 const pageNum = (userPagination && userPagination.page) ? userPagination.page : 1;
                 const baseIndex = ((pageNum - 1) * 10) + idx + 1;
            %>
              <tr data-user-id="<%= user._id %>">
                <td class="row-index"><%= baseIndex %></td>
                <td>
                  <strong style="color:#fff;"><%= user.username || '-' %></strong><br>
                  <small class="muted"><%= user.email || '-' %></small>
                </td>
                <td>
                  <% if (user.isAdmin) { %>
                    <span class="badge badge-admin">Admin</span>
                  <% } else { %>
                    <span class="badge badge-user">User</span>
                  <% } %>
                </td>
                <td><%= user.createdAt ? new Date(user.createdAt).toLocaleString() : '-' %></td>
                <td class="actions">
                  <% if (!user.isAdmin) { %>
                    <form action="/admin/users/<%= user._id %>/promote" method="POST" onsubmit="return confirmPromote('<%= user.username || user.email %>')" style="display:inline-block;">
                      <button class="btn small primary" type="submit">Promote</button>
                    </form>
                  <% } else { %>
                    <% if (currentUser && currentUser._id && (currentUser._id.toString() === user._id.toString())) { %>
                      <button class="btn small muted" title="You cannot demote yourself" disabled>Demote</button>
                    <% } else { %>
                      <form action="/admin/users/<%= user._id %>/demote" method="POST" onsubmit="return confirmDemote('<%= user.username || user.email %>')" style="display:inline-block;">
                        <button class="btn small warning" type="submit">Demote</button>
                      </form>
                    <% } %>
                  <% } %>

                  <% if (currentUser && currentUser._id && (currentUser._id.toString() === user._id.toString())) { %>
                    <button class="btn small muted" title="You cannot delete your own account" disabled>Delete</button>
                  <% } else { %>
                    <form action="/admin/users/<%= user._id %>?_method=DELETE" method="POST" onsubmit="return confirmDeleteUser('<%= user.username || user.email %>')" style="display:inline-block;">
                      <button class="btn small danger" type="submit">Delete</button>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <% if (userPagination && userPagination.pageCount > 1) { %>
        <nav class="pagination-nav" style="margin-top:12px;">
          <% for(let i=1; i<=userPagination.pageCount; i++) { %>
            <% if (i === (userPagination && userPagination.page ? userPagination.page : 1)) { %>
              <span class="page active"><%= i %></span>
            <% } else { %>
              <a class="page" href="?userPage=<%= i %>&listingPage=<%= (listingPagination && listingPagination.page) ? listingPagination.page : 1 %>"><%= i %></a>
            <% } %>
          <% } %>
        </nav>
      <% } %>
    </div>

    <!-- RIGHT COLUMN: Listings + Reviews -->
    <div style="display:flex;flex-direction:column;gap:1.25rem;">

      <!-- LISTINGS CARD -->
      <div class="table-card" aria-labelledby="listingsHeading">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">
          <h3 class="table-title" id="listingsHeading" style="margin:0;">Listings</h3>
          <small class="muted">Page <%= (listingPagination && listingPagination.page) ? listingPagination.page : 1 %></small>
        </div>

        <div style="overflow:auto;">
          <table class="custom-table" id="listingsTable">
            <thead>
              <tr>
                <th style="width:56px">#</th>
                <th>Title</th>
                <th style="width:200px">ID</th>
                <th style="width:140px">Owner</th>
                <th style="width:180px">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% listings.forEach((listing, idx) => {
                   const listPageNum = (listingPagination && listingPagination.page) ? listingPagination.page : 1;
                   const listIndex = ((listPageNum - 1) * 10) + idx + 1;
              %>
                <tr data-listing-id="<%= listing._id %>">
                  <td><%= listIndex %></td>
                  <td>
                    <a href="/listings/<%= listing._id %>" target="_blank" rel="noopener noreferrer" style="color:#dbeafe;">
                      <%= listing.title %>
                    </a>
                  </td>
                  <td><%= listing._id %></td>
                  <td><%= listing.owner ? (listing.owner.username || listing.owner.email) : '—' %></td>
                  <td class="actions">
                    <a class="btn small" href="/listings/<%= listing._id %>">View</a>

                    <!-- Delete listing form for admins -->
                    <form action="/admin/listings/<%= listing._id %>?_method=DELETE" method="POST" onsubmit="return confirmDeleteListing('<%= listing.title %>')" style="display:inline-block;margin-left:6px;">
                      <button class="btn small danger" type="submit">Delete</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <% if (listingPagination && listingPagination.pageCount > 1) { %>
          <nav class="pagination-nav" style="margin-top:12px;">
            <% for(let i=1; i<=listingPagination.pageCount; i++) { %>
              <% if (i === (listingPagination && listingPagination.page ? listingPagination.page : 1)) { %>
                <span class="page active"><%= i %></span>
              <% } else { %>
                <a class="page" href="?userPage=<%= (userPagination && userPagination.page) ? userPagination.page : 1 %>&listingPage=<%= i %>"><%= i %></a>
              <% } %>
            <% } %>
          </nav>
        <% } %>
      </div>

      <!-- REVIEWS CARD -->
      <div class="table-card" aria-labelledby="reviewsHeading">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">
          <h3 class="table-title" id="reviewsHeading" style="margin:0;">Recent Reviews</h3>
          <small class="muted">Latest 10</small>
        </div>

        <% if (reviews && reviews.length) { %>
          <ul class="list-group">
            <% reviews.forEach((review) => { %>
              <li class="list-group-item">
                <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;">
                  <div>
                    <strong><%= review.author ? (review.author.username || review.author.email) : 'Unknown' %></strong>
                    <small class="muted"> — <a href="/listings/<%= review.listing %>">View listing</a></small>
                    <p style="margin:8px 0 0 0;color:inherit;"><%= review.body %></p>
                  </div>
                  <div class="muted" style="font-size:0.85rem;"><%= review.createdAt ? new Date(review.createdAt).toLocaleString() : '' %></div>
                </div>
              </li>
            <% }) %>
          </ul>
        <% } else { %>
          <p class="muted">No recent reviews found.</p>
        <% } %>
      </div>
    </div>
  </div>
</div>

<%- include('../includes/footer') %>

<!-- Socket.IO client for live new-user insertion and listingDeleted handling -->
<script src="/socket.io/socket.io.js"></script>
<script>
  // small search filter for users & listings
  (function() {
    const searchInput = document.getElementById('adminSearch');
    if (!searchInput) return;
    searchInput.addEventListener('input', function() {
      const q = (this.value || '').toLowerCase().trim();
      const usersRows = document.querySelectorAll('#usersTbody tr');
      usersRows.forEach(row => {
        const text = row.innerText.toLowerCase();
        row.style.display = text.includes(q) ? '' : 'none';
      });
      // listings table (right column)
      const listingRows = document.querySelectorAll('#listingsTable tbody tr');
      listingRows.forEach(row => {
        const text = row.innerText.toLowerCase();
        row.style.display = text.includes(q) ? '' : 'none';
      });
    });
  })();

  // Confirm dialogs
  function confirmPromote(name) { return confirm('Promote ' + (name || 'this user') + ' to admin?'); }
  function confirmDemote(name) { return confirm('Remove admin rights from ' + (name || 'this user') + '?'); }
  function confirmDeleteUser(name) { return confirm('Permanently delete user ' + (name || 'this user') + '? This cannot be undone.'); }
  function confirmDeleteListing(title) { return confirm('Permanently delete listing "' + (title || 'this listing') + '"? This cannot be undone.'); }

  // Live new user inserts (only for admins on page 1)
  (function() {
    const isAdmin = <%- JSON.stringify(Boolean(currentUser && currentUser.isAdmin)) %>;
    const currentPage = <%- JSON.stringify((userPagination && userPagination.page) ? userPagination.page : 1) %>;
    const currentUserId = <%- JSON.stringify(currentUser ? String(currentUser._id) : null) %>;

    // If not an admin or not on page 1, we don't insert live rows (keeps pagination sane)
    if (!isAdmin || currentPage !== 1) return;

    const socket = io();
    socket.on('connect', () => console.log('Admin socket connected', socket.id));

    // New user created
    socket.on('newUser', (user) => {
      try {
        if (!user || !user._id) return;
        const tbody = document.getElementById('usersTbody');
        if (!tbody) return;
        if (tbody.querySelector(`tr[data-user-id="${escapeAttr(user._id)}"]`)) return; // already there

        const tr = document.createElement('tr');
        tr.setAttribute('data-user-id', user._id);

        const tdIndex = document.createElement('td');
        tdIndex.className = 'row-index';
        tdIndex.textContent = '1';
        tr.appendChild(tdIndex);

        const tdUser = document.createElement('td');
        tdUser.innerHTML = `<strong style="color:#fff;">${escapeHtml(user.username || '-')}</strong><br><small class="muted">${escapeHtml(user.email || '-')}</small>`;
        tr.appendChild(tdUser);

        const tdRole = document.createElement('td');
        tdRole.innerHTML = user.isAdmin ? '<span class="badge badge-admin">Admin</span>' : '<span class="badge badge-user">User</span>';
        tr.appendChild(tdRole);

        const tdJoined = document.createElement('td');
        tdJoined.textContent = user.createdAt ? new Date(user.createdAt).toLocaleString() : new Date().toLocaleString();
        tr.appendChild(tdJoined);

        const tdActions = document.createElement('td');
        tdActions.className = 'actions';

        if (String(currentUserId) !== String(user._id)) {
          const promoteForm = document.createElement('form');
          promoteForm.action = `/admin/users/${escapeAttr(user._id)}/promote`;
          promoteForm.method = 'POST';
          promoteForm.onsubmit = function() { return confirmPromote(user.username || user.email); };
          promoteForm.innerHTML = `<button class="btn small primary" type="submit">Promote</button>`;
          tdActions.appendChild(promoteForm);

          const deleteForm = document.createElement('form');
          deleteForm.action = `/admin/users/${escapeAttr(user._id)}?_method=DELETE`;
          deleteForm.method = 'POST';
          deleteForm.onsubmit = function() { return confirmDeleteUser(user.username || user.email); };
          deleteForm.innerHTML = `<button class="btn small danger" type="submit">Delete</button>`;
          tdActions.appendChild(deleteForm);
        } else {
          const btn = document.createElement('button');
          btn.className = 'btn small muted';
          btn.disabled = true;
          btn.textContent = 'Manage';
          tdActions.appendChild(btn);
        }

        tr.appendChild(tdActions);
        tbody.insertBefore(tr, tbody.firstChild);

        // renumber
        const indexCells = tbody.querySelectorAll('td.row-index');
        indexCells.forEach((cell, idx) => { cell.textContent = (idx + 1).toString(); });
      } catch (err) {
        console.error('Error in newUser handler', err);
      }
    });

    // Listing deleted — remove the row from listings table
    socket.on('listingDeleted', (payload) => {
      try {
        if (!payload || !payload.id) return;
        const row = document.querySelector(`#listingsTable tbody tr[data-listing-id="${escapeAttr(payload.id)}"]`);
        if (!row) return;
        row.remove();
        // renumber listing indices
        const listingIndexCells = document.querySelectorAll('#listingsTable tbody tr td:first-child');
        listingIndexCells.forEach((cell, idx) => { cell.textContent = (idx + 1).toString(); });
      } catch (err) {
        console.error('Error handling listingDeleted event', err);
      }
    });

    function escapeHtml(s) {
      if (s === undefined || s === null) return '';
      return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#039;');
    }
    function escapeAttr(s) {
      if (s === undefined || s === null) return '';
      return String(s).replace(/"/g,'&quot;').replace(/'/g,'&#039;');
    }
  })();
</script>
