<nav class="navbar glass-navbar">
  <div class="navbar-container">
    <!-- Left: Logo -->
    <a href="/" class="navbar-logo">AuctionEase</a>

    <!-- 🔗 Quick nav links beside logo -->
    <div class="navbar-links">
      <a href="/listings" class="nav-link">All Listings</a>
      <a href="/listings/new" class="nav-link">New Listing</a>
    </div>

    <!-- Right: Wallet + Profile -->
    <div class="navbar-right">
      <% if (currentUser) { %>
        <% 
          const displayName = currentUser.name
                              || currentUser.username
                              || (currentUser.email ? currentUser.email.split('@')[0] : 'Profile');
          const avatarUrl = currentUser.avatar 
                            || currentUser.profilePicture 
                            || '/images/default-avatar.png';
        %>

        <!-- Wallet -->
        <a href="/wallet" class="wallet-btn" aria-label="Wallet">
          <svg xmlns="http://www.w3.org/2000/svg"
               class="wallet-icon"
               viewBox="0 0 24 24"
               fill="none"
               stroke="currentColor"
               stroke-width="2"
               stroke-linecap="round"
               stroke-linejoin="round">
            <path d="M3 7h18" />
            <path d="M3 7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z" />
            <circle cx="16" cy="12" r="1" />
          </svg>
          <span class="wallet-label">Wallet —</span>
          ₹<span id="nav-balance"><%= Number(currentUser.walletBalance || 0).toLocaleString("en-IN") %></span>
        </a>

        <!-- Profile Dropdown -->
        <div class="dropdown navbar-profile" role="menu" aria-haspopup="true" aria-expanded="false">
          <div class="dropdown-toggle" onclick="toggleProfileDropdown()" tabindex="0">
            <img src="<%= avatarUrl %>" alt="profile" class="navbar-avatar"/>
            <span class="navbar-username"><%= displayName %></span>
          </div>

          <div class="dropdown-menu" id="profileDropdown">
            <a href="/">Home</a>
            <a href="/profile">My Profile</a>
            <% if (currentUser.isAdmin) { %>
              <a href="/admin/dashboard">Admin Panel</a>
            <% } %>
            <a href="/logout">Logout</a>
          </div>
        </div>
      <% } else { %>
        <!-- Guest view -->
        <a href="/login" class="wallet-btn">Login</a>
        <a href="/signup" class="wallet-btn">Register</a>
      <% } %>
    </div>
  </div>
</nav>

<style>
  .glass-navbar {
    backdrop-filter: blur(16px);
    background: rgba(18, 18, 18, 0.269);
    border-bottom: 1px solid rgba(19, 19, 19, 0.1);
    padding: 1rem 0;
    position: sticky;
    top: 0;
    z-index: 1000;
    font-family: 'SF Pro Display', 'Segoe UI', sans-serif;
  }

  .navbar-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .navbar-logo {
    font-size: 1.8rem;
    font-weight: bold;
    color: #2b2b2b;
    text-decoration: none;
  }
  .navbar-logo:hover { color: #ffffff; }

  /* New quick links */
  .navbar-links {
    display: flex;
    gap: 1rem;
    margin-left: 1.5rem;
  }
  .navbar-links .nav-link {
    color: #2b2b2b;
    text-decoration: none;
    font-weight: 600;
    padding: 0.4rem 0.9rem;
    border-radius: 12px;
    transition: all 0.25s ease;
  }
  .navbar-links .nav-link:hover {
    background: rgba(0, 123, 255, 0.15);
    color: #000;
    transform: translateY(-2px);
  }

  .navbar-right {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .wallet-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    background: rgba(255, 255, 255, 0.15);
    padding: 0.4rem 0.9rem;
    border-radius: 20px;
    color: #2b2b2b;
    text-decoration: none;
    transition: background 0.3s ease, transform 0.12s ease;
  }
  .wallet-btn:hover { background: rgba(255, 255, 255, 0.25); }
  .wallet-btn:active { transform: translateY(1px); }

  .wallet-icon {
    width: 18px; height: 18px;
    color: #2b2b2b;
  }

  .dropdown { position: relative; }
  .dropdown-menu {
    display: none;
    position: absolute;
    top: 110%; right: 0;
    background: rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(14px);
    border-radius: 15px;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
    min-width: 180px;
    overflow: hidden;
  }
  .dropdown-menu a {
    display: block;
    padding: 12px 20px;
    color: #2b2b2b;
    text-decoration: none;
    font-size: 1rem;
    font-weight: 500;
    transition: background 0.3s ease, transform 0.2s ease;
  }
  .dropdown-menu a:hover {
    background: rgba(0, 123, 255, 0.2);
    transform: translateX(5px);
    color: #000;
  }
  .dropdown.show .dropdown-menu { display: block; }

  .navbar-profile {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    background: rgba(255, 255, 255, 0.15);
    padding: 0.4rem 0.8rem;
    border-radius: 30px;
    cursor: pointer;
    transition: background 0.3s ease;
  }
  .navbar-profile:hover { background: rgba(255, 255, 255, 0.25); }

  .navbar-avatar {
    width: 45px; height: 45px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid #2b2b2b;
  }
  .navbar-username { font-size: 1rem; font-weight: 600; color: #2b2b2b; }

  @media (max-width: 700px) {
    .navbar-container { padding: 0 0.75rem; }
    .navbar-logo { font-size: 1.2rem; }
    .navbar-avatar { width: 36px; height: 36px; }
    .wallet-label { display: none; }
    .navbar-links { display: none; } /* hide quick links on small screens */
  }
</style>

<script>
  function toggleProfileDropdown() {
    const profile = document.querySelector(".navbar-profile");
    if (!profile) return;
    profile.classList.toggle("show");
    const expanded = profile.classList.contains("show");
    profile.setAttribute("aria-expanded", expanded ? "true" : "false");
  }

  window.onclick = function(event) {
    if (!event.target.closest('.navbar-profile')) {
      document.querySelector(".navbar-profile")?.classList.remove("show");
      document.querySelector(".navbar-profile")?.setAttribute("aria-expanded", "false");
    }
  }

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      document.querySelector(".navbar-profile")?.classList.remove("show");
      document.querySelector(".navbar-profile")?.setAttribute("aria-expanded", "false");
    }
  });

  // 🔄 Live balance updater
  (function () {
    const balEl = document.getElementById("nav-balance");
    if (!balEl) return;
    const fmtINR = n => Number(n || 0).toLocaleString("en-IN");
    async function fetchBalance() {
      try {
        const res = await fetch("/api/me/balance", { headers: { "Accept": "application/json" } });
        if (!res.ok) return;
        const data = await res.json();
        if (typeof data.balance !== "undefined") {
          balEl.textContent = fmtINR(data.balance);
        }
      } catch (e) {}
    }
    fetchBalance();
    window.addEventListener("focus", fetchBalance);
    setInterval(fetchBalance, 15000);
  })();
</script>
